# Copia este archivo a `.env` SOLO en tu máquina local. Nunca subas `.env` a GitHub.
# La app Flutter NO lee este archivo. El backend Flask sí lo lee para proteger la clave.

# URL base del backend WHATCANICOOK desde la app.
# En emulador Android: http://10.0.2.2:5000
# En dispositivo físico: http://<IP_DE_TU_PC>:5000
# En producción: https://tu-dominio-seguro.example
WHATCANICOOK_API_BASE_URL=http://10.0.2.2:5000

# Solo para el backend. Clave de Google AI Studio (NUNCA dentro del APK ni en GitHub).
GEMINI_API_KEY=PEGAR_AQUI_LA_CLAVE_DEL_BACKEND

# Modelo de Gemini con capacidad de visión. Ver documentación oficial.
GEMINI_MODEL=gemini-3.8-flash

# Origen permitido para CORS (por defecto * solo en desarrollo).
CORS_ORIGINS=*
