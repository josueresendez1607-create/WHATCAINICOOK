<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        WHATCANICOOK se distribuye para desarrollo local contra el backend
        del host. Se permite HTTP únicamente para esos hosts locales; cualquier
        otro dominio debe usar HTTPS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- IP LAN del PC: permite usar el backend por Wi-Fi sin cable USB. -->
        <domain includeSubdomains="false">192.168.1.76</domain>
    </domain-config>
</network-security-config>
